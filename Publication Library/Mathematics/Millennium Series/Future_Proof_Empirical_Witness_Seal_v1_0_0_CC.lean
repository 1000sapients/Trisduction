/-! ===================================================================================================================
    PART W · FUTURE PROOF WITH EMPIRICAL WITNESS (namespace FPEW) · Future_Proof_Empirical_Witness_Seal_v1_0_0_CC

    THE GATE, FORMALLY PROVED AND EMPIRICALLY WITNESSED. Every route to a row's value passes the row's one bit: that is
    proved here once, on the block's generic row, and read on six rows, the Riemann, P ≠ NP, Poincaré, Yang–Mills,
    Goldbach and Navier–Stokes rows. The theorem quantifies over every premise, so it binds every proof yet to be
    written. The record then supplied the empirical half: four routes published independently after the Trisduction
    record of their rows, each typed below at its exact shape, and each lands where the gate says it must. None passes
    around the bit. The record is the ledger of Part L.

    THE FOUR WITNESSES, TYPED.
      OpenAI, Yang–Mills existence (first public 26 Oct 2026; row of record 4 Oct 2026): the existence half alone. It
        forces nothing on the row, and at the host it is not the sentence.
      OpenAI, Navier–Stokes forced blowup (first public 8 Sep 2026; row of record 8 Sep 2026, contemporaneous): a
        sentence on the forced host. It decides nothing about the unforced sentence, statement (A), which is the row.
      Reams–Helfgott, ternary Goldbach in Lean (first public 29 Oct 2026; row of record 4 Oct 2026): the ternary
        statement. Binary gives ternary, proved here on the kernel's own primes; ternary does not carry binary on the
        form, proved on an admissible counter-predicate. Their route never reaches the binary bit.
      Nielsen–Semita, RH in Lean (first public 12 Nov 2026; row of record 15 Oct 2026): three proofs, three deliveries
        of the bit by axiom. Proof III adopts the sentence (adoption is the bit); Proof II declares provability (a
        ladder that proves the value proves the bit and enters by the act's door); Proof I declares the obstruction
        (exactly the block's condition) and reflects it to the value (a route, so the act).
      Their prose of 12 Dec 2025 carries no Lean and stands in the ledger as prior and prose-only; the gate binds it
      all the same, past and future alike.

    RATIONALE. A claim that later proofs confirm a structure is empirical only if the structure was public first and
      the later proofs are typed by theorem, not by description. Part L fixes the first-public dates from the public
      records; Parts W and F type each route against the carried kernels; the binding theorem ties both by exact type.
    DESIGN. The file carries four kernels byte for byte, in this order: ZFC_Block_Hardened_v1_3_0.lean of the register
      (sha256 756c6580a0f13ce8…, 59,168 B), YM_Normal_Form_Paper_v1_1_0_CC.lean (sha256 150dc58f223ecac9…,
      129,415 B, Zenodo 23162231), GB_Normal_Form_Paper_v1_1_0_CC.lean (sha256 cfca06f3df9cdb1f…, 151,409 B, Zenodo
      23162238), NS_Normal_Form_Paper_v1_1_0_CC.lean (md5 c01f017bb3f14017…, 128,228 B, Zenodo 23591619). Each
      kernel's own row is read onto the block's generic `Row` by `toBlockRow`, and the block's `Bit` is proved to be
      the kernel's own `Transfer` (`*_bit_is_the_transfer`, by `Iff.rfl`). No kernel definition is restated.
    NON-NEGOTIABLES. Core Lean 4.19.0; no import, no axiom declared, no sorry, no native_decide. Every theorem of this
      Part is pinned by `#guard_msgs`. The dates are record grade and stand as data, compared by `decide` only. The
      form, the gate and the witness typings are theorem grade. The bit stays a hypothesis everywhere: no declaration
      of this Part inhabits it.
    RISKS. The typing of each witness is read from its own published text and Lean names (OpenAI's announcements, the
      Reams–Helfgott README and `Statement.lean`, Nielsen–Semita's appendix modules); that reading is the fidelity
      step and is printed in the companion paper. A later Lean release may move an elaboration detail; the pins then
      fail loudly. ΔM = 0.
=================================================================================================================== -/
namespace FPEW
universe u v w
open ZFCBlockHardened

/-! ## Part R · the six rows on the block's generic row -/

/-- A KERNEL ROW READ ON THE BLOCK: frames, every frame admissible, the kernel's value, sameness by record, the
    kernel's record map, and the kernel's calm and counter frames as the compliant configuration and its twin. -/
def toBlockRow {Fr : Type 1} (V : Fr → Prop) (Rc : Fr → Fr) (hr : ∀ F, V (Rc F)) (c t : Fr)
    (hc : V c) (ht : ¬ V t) (same : Rc c = Rc t) : Row.{1} :=
  ⟨Fr, fun _ => True, V, fun F G => Rc F = Rc G, Rc, fun x _ => hr x, c, t, trivial, trivial, same, hc, ht⟩

/-- THE YANG–MILLS ROW, from the deposited kernel's `ymRow`. -/
def ymB : Row.{1} :=
  toBlockRow YM.HOST.ymRow.Value YM.HOST.ymRow.Rec YM.HOST.ymRow.record_has_value YM.HOST.ymRow.calm
    YM.HOST.ymRow.counter YM.HOST.ymRow.calm_value YM.HOST.ymRow.counter_fails rfl

/-- THE GOLDBACH ROW, from the deposited kernel's `gbRow`. -/
def gbB : Row.{1} :=
  toBlockRow GB.HOST.gbRow.Value GB.HOST.gbRow.Rec GB.HOST.gbRow.record_has_value GB.HOST.gbRow.calm
    GB.HOST.gbRow.counter GB.HOST.gbRow.calm_value GB.HOST.gbRow.counter_fails rfl

/-- THE NAVIER–STOKES ROW, from the deposited kernel's `nsRow`: the unforced row, statement (A). -/
def nsB : Row.{1} :=
  toBlockRow NS.HOST.nsRow.Value NS.HOST.nsRow.Rec NS.HOST.nsRow.record_has_value NS.HOST.nsRow.calm
    NS.HOST.nsRow.counter NS.HOST.nsRow.calm_value NS.HOST.nsRow.counter_fails rfl

/-- THE BLOCK'S BIT IS THE KERNEL'S TRANSFER, on Yang–Mills: one bit, not two readings of it. -/
theorem ym_bit_is_the_transfer (F : ymB.X) : Bit ymB F ↔ YM.NORMALFORM.Transfer YM.HOST.ymRow F := Iff.rfl

/-- THE BLOCK'S BIT IS THE KERNEL'S TRANSFER, on Goldbach. -/
theorem gb_bit_is_the_transfer (F : gbB.X) : Bit gbB F ↔ GB.NORMALFORM.Transfer GB.HOST.gbRow F := Iff.rfl

/-- THE BLOCK'S BIT IS THE KERNEL'S TRANSFER, on Navier–Stokes. -/
theorem ns_bit_is_the_transfer (F : nsB.X) : Bit nsB F ↔ NS.NORMALFORM.Transfer NS.HOST.nsRow F := Iff.rfl

/-! ## Part F · the gate, future proof -/

/-- THE GATE OF A ROW: at every admissible configuration, every premise that gives the value gives the act and the
    bit. The premise is any proposition whatever: any author, any date, any vocabulary, any method. -/
def Gate (r : Row.{u}) : Prop :=
  ∀ x, r.Adm x → ∀ Q : Prop, (Q → r.Value x) → Q → ActAt r x ∧ Bit r x

/-- NO ROUTE BYPASSES THE GATE, on every row. -/
theorem no_route_bypasses_the_gate (r : Row.{u}) : Gate r :=
  fun x hx Q h q => ⟨every_way_is_the_act r x hx Q h q, fun _ => h q⟩

/-- NO ROUTE REACHES THE VALUE WITH THE BIT FALSE, on every row: the bypass is closed. -/
theorem no_bypass (r : Row.{u}) (x : r.X) (hx : r.Adm x) : ¬ ∃ Q : Prop, Q ∧ (Q → r.Value x) ∧ ¬ Bit r x :=
  (exit_bypass_closed r x hx).2

/-- THE GATE ON THE SIX ROWS. -/
theorem the_gate_on_six_rows :
    Gate RH.row ∧ Gate PNP.row ∧ Gate PC.row ∧ Gate ymB ∧ Gate gbB ∧ Gate nsB :=
  ⟨no_route_bypasses_the_gate _, no_route_bypasses_the_gate _, no_route_bypasses_the_gate _,
   no_route_bypasses_the_gate _, no_route_bypasses_the_gate _, no_route_bypasses_the_gate _⟩

/-- THE GATE AT THE HOSTS, future proof: every premise that gives the host's sentence gives the host's bit, on
    Yang–Mills and Navier–Stokes at every host and on Goldbach at the arithmetic frame. -/
theorem the_gate_at_the_hosts :
    (∀ (H : YM.HOST.Host) (Q : Prop), (Q → H.Sentence) → Q → YM.SUPPLY.FormalCargo H) ∧
    (∀ (H : NS.HOST.Host) (Q : Prop), (Q → H.Sentence) → Q → NS.SUPPLY.FormalCargo H) ∧
    (∀ Q : Prop, (Q → GBClose.GoldbachStd) → Q → GB.SUPPLY.FormalCargo) :=
  ⟨fun H _ h q => (YM.SUPPLY.formal_iff_sentence H).mpr (h q),
   fun H _ h q => (NS.SUPPLY.formal_iff_sentence H).mpr (h q),
   fun _ h q => GB.SUPPLY.formal_iff_statement.mpr (h q)⟩

/-! ## Part W · the witnesses, typed -/

/-! ### W1 · OpenAI, Yang–Mills existence: the existence half -/

/-- The existence half of the Yang–Mills host's sentence: for every gauge group a theory exists. -/
def ExistenceHalf (H : YM.HOST.Host) : Prop := ∀ G, ∃ n, H.theory G = some n

/-- W1, AT THE HOST: a host where every theory exists and the sentence fails. Existence, however large, is not the
    sentence. -/
theorem existence_half_is_not_the_sentence :
    ExistenceHalf (YM.HOST.oneGroup 0) ∧ ¬ (YM.HOST.oneGroup 0).Sentence :=
  ⟨fun _ => ⟨0, rfl⟩, fun h => Nat.lt_irrefl 0 (h ()).2⟩

/-- W1, ON THE ROW: existence everywhere forces nothing; the twin frame has it and fails the value. -/
theorem existence_half_forces_nothing : ¬ Forces ymB (fun F => YMClose.ExistsAll F) :=
  fun h => ymB.value_t (h ymB.twin trivial (fun _ => ⟨0, rfl⟩))

/-! ### W2 · OpenAI, Navier–Stokes forced blowup: the forced host -/

/-- A forced construction and the row it is read against: the unforced host of statement (A) and the forced host. -/
structure ForcedPair where
  unforced : NS.HOST.Host
  forced   : NS.HOST.Host

/-- A forced blowup: the forced host's sentence fails. -/
def ForcedBlowup (P : ForcedPair) : Prop := ¬ P.forced.Sentence

/-- The calm host: every flow finite at every time. -/
def calmHost : NS.HOST.Host := ⟨Unit, fun _ _ => some 0⟩

/-- The burst host: the flow is finite at time zero and unbounded after. -/
def burstHost : NS.HOST.Host := ⟨Unit, fun _ t => match t with | 0 => some 0 | _ + 1 => none⟩

theorem calmHost_sentence : calmHost.Sentence := fun _ _ => ⟨0, rfl⟩

theorem burstHost_fails : ¬ burstHost.Sentence := fun h => match h () 1 with
  | ⟨_, hn⟩ => Option.noConfusion hn

/-- W2: A FORCED BLOWUP DECIDES NOTHING ABOUT STATEMENT (A). It stands beside an unforced host that is regular and
    beside one that blows up. A bridge from the forced host to the unforced one is a further premise, and any premise
    that gives (A) passes the gate. -/
theorem forced_blowup_decides_nothing :
    (∃ P : ForcedPair, ForcedBlowup P ∧ P.unforced.Sentence) ∧
    (∃ P : ForcedPair, ForcedBlowup P ∧ ¬ P.unforced.Sentence) :=
  ⟨⟨⟨calmHost, burstHost⟩, burstHost_fails, calmHost_sentence⟩,
   ⟨⟨burstHost, burstHost⟩, burstHost_fails, burstHost_fails⟩⟩

/-! ### W3 · Reams–Helfgott, ternary Goldbach: the weaker statement -/

/-- n is a sum of two members of P. -/
def SumOfTwo (P : Nat → Prop) (n : Nat) : Prop := ∃ p q, P p ∧ P q ∧ p + q = n

/-- n is a sum of three members of P. -/
def SumOfThree (P : Nat → Prop) (n : Nat) : Prop := ∃ p q r, P p ∧ P q ∧ P r ∧ p + q + r = n

/-- THE BINARY FORM over P: every even number at least four, written 2(k+2), is a sum of two. -/
def BinaryP (P : Nat → Prop) : Prop := ∀ k, SumOfTwo P (2 * (k + 2))

/-- THE TERNARY FORM over P: every odd number above five, written 2(k+2)+3, is a sum of three. -/
def TernaryP (P : Nat → Prop) : Prop := ∀ k, SumOfThree P (2 * (k + 2) + 3)

/-- BINARY GIVES TERNARY, over every P containing three. -/
theorem binary_gives_ternary (P : Nat → Prop) (h3 : P 3) (hB : BinaryP P) : TernaryP P :=
  fun k => match hB k with
    | ⟨p, q, hp, hq, hs⟩ => ⟨3, p, q, h3, hp, hq, by rw [Nat.add_assoc, hs, Nat.add_comm]⟩

/-- Three is prime in the kernel's own arithmetic, read from the remainder. -/
theorem kernel_prime_three : GBClose.Prime 3 :=
  ⟨Nat.le_succ 2, fun e h2 h3 => by
    have he : e = 2 := Nat.le_antisymm (Nat.le_of_lt_succ h3) h2
    subst he; decide⟩

/-- THE KERNEL'S GOLDBACH STATEMENT GIVES THE BINARY FORM over the kernel's primes, through the kernel's
    `even_double`. -/
theorem kernel_binary_form : GBClose.GoldbachStd → BinaryP GBClose.Prime :=
  fun h k => h (2 * (k + 2)) (GBClose.even_double k)

/-- W3, THE DIRECTION OF SUBSUMPTION: the binary statement gives the ternary statement on the kernel's primes. A proof
    of binary is a proof of ternary; the ternary theorem is downstream of the binary bit. -/
theorem binary_statement_gives_ternary : GBClose.GoldbachStd → TernaryP GBClose.Prime :=
  fun h => binary_gives_ternary GBClose.Prime kernel_prime_three (kernel_binary_form h)

/-- The admissible counter-predicate: one, and the odd numbers from five on. Three is absent. -/
def OddButThree (n : Nat) : Prop := n = 1 ∨ ∃ j, n = 2 * j + 5

/-- The counter-predicate carries the ternary form. -/
theorem counter_ternary : TernaryP OddButThree :=
  fun k => ⟨1, 1, 2 * k + 5, Or.inl rfl, Or.inl rfl, Or.inr ⟨k, rfl⟩, by rw [Nat.add_comm (1 + 1)]; rfl⟩

/-- The counter-predicate fails the binary form at four. -/
theorem counter_not_binary : ¬ BinaryP OddButThree := fun h => match h 0 with
  | ⟨p, q, hp, hq, hs⟩ => by
    rcases hp with hp1 | ⟨j, hj⟩
    · rcases hq with hq1 | ⟨i, hi⟩
      · subst hp1; subst hq1; exact absurd hs (by decide)
      · have h5 : 5 ≤ p + q := by
          rw [hi]; exact Nat.le_trans (Nat.le_add_left 5 (2 * i)) (Nat.le_add_left _ p)
        rw [hs] at h5; exact absurd h5 (by decide)
    · have h5 : 5 ≤ p + q := by
        rw [hj]; exact Nat.le_trans (Nat.le_add_left 5 (2 * j)) (Nat.le_add_right _ q)
      rw [hs] at h5; exact absurd h5 (by decide)

/-- W3: TERNARY DOES NOT CARRY BINARY ON THE FORM. The implication from ternary to binary fails for an admissible
    predicate, so no ternary proof reaches the binary bit by its shape. On the actual primes the converse cannot be
    refuted unless binary fails; the ternary route stays downstream of the bit. -/
theorem ternary_does_not_carry_binary : ¬ ∀ P : Nat → Prop, TernaryP P → BinaryP P :=
  fun h => counter_not_binary (h OddButThree counter_ternary)

/-! ### W4 · Nielsen–Semita, RH in Lean: three deliveries by axiom -/

/-- W4, PROOF III: ADOPTION IS THE BIT. An axiom equivalent to the value is equivalent to the bit; adopting it is
    adopting the sentence. -/
theorem adoption_is_the_bit (r : Row.{u}) (x : r.X) (hx : r.Adm x) (A : Prop) (h : A ↔ r.Value x) :
    A ↔ Bit r x :=
  h.trans (exit_bypass_closed r x hx).1.symm

/-- W4, PROOF II: DECLARED PROVABILITY IS THE BIT. A ladder that proves the value proves the bit, and at every model
    it enters by the act's door. -/
theorem declared_provability_is_the_bit (r : Row.{u}) (T : Ladder.{v}) (N : NormalForm T)
    (R : OnRow.{u, v, w} r T N) (p : T.Prov N.V) : T.Prov N.B ∧ ∀ m : R.M, ActAt r (R.real m) :=
  ⟨(no_escape T N).mp p, fun m => one_door r T N R p m⟩

/-- W4, PROOF I: THE DECLARED OBSTRUCTION IS THE BLOCK'S CONDITION. With completeness as the hypothesis, the ladder is
    blocked from the value and from the bit exactly when a model realizes a configuration without the value. -/
theorem declared_obstruction_is_the_block (r : Row.{u}) (T : Ladder.{v}) (N : NormalForm T)
    (R : OnRow.{u, v, w} r T N) (complete : ¬ T.Prov N.V → ∃ m, ¬ R.Holds m N.V) :
    (¬ T.Prov N.V ∧ ¬ T.Prov N.B) ↔ ∃ m, ¬ r.Value (R.real m) :=
  blocked_iff_defiant_model r T N R complete

/-- W4, PROOF I: REFLECTION IS A ROUTE. Whatever premise the reflection starts from, if it ends at the value it gives
    the act and the bit. -/
theorem reflection_is_a_route (r : Row.{u}) (x : r.X) (hx : r.Adm x) (Obstruction : Prop)
    (reflect : Obstruction → r.Value x) (o : Obstruction) : ActAt r x ∧ Bit r x :=
  no_route_bypasses_the_gate r x hx Obstruction reflect o

/-- W4 READ ON THE RIEMANN ROW, at its compliant configuration: Proof III's adoption and Proof I's reflection each
    deliver the bit there. -/
theorem nielsen_on_the_riemann_row :
    (∀ A : Prop, (A ↔ RH.row.Value RH.row.compliant) → (A ↔ Bit RH.row RH.row.compliant)) ∧
    (∀ O : Prop, (O → RH.row.Value RH.row.compliant) → O → ActAt RH.row RH.row.compliant) :=
  ⟨fun A h => adoption_is_the_bit RH.row RH.row.compliant RH.row.adm_c A h,
   fun O h o => (reflection_is_a_route RH.row RH.row.compliant RH.row.adm_c O h o).1⟩

/-- EVERY WITNESS TYPED: the existence half forces nothing; a forced blowup decides nothing about (A); ternary does not
    carry binary while binary gives ternary; adoption, declared provability and reflection each deliver the bit. -/
theorem every_witness_typed :
    (ExistenceHalf (YM.HOST.oneGroup 0) ∧ ¬ (YM.HOST.oneGroup 0).Sentence) ∧
    ¬ Forces ymB (fun F => YMClose.ExistsAll F) ∧
    ((∃ P : ForcedPair, ForcedBlowup P ∧ P.unforced.Sentence) ∧
      (∃ P : ForcedPair, ForcedBlowup P ∧ ¬ P.unforced.Sentence)) ∧
    (GBClose.GoldbachStd → TernaryP GBClose.Prime) ∧
    (¬ ∀ P : Nat → Prop, TernaryP P → BinaryP P) ∧
    (∀ (r : Row.{0}) (x : r.X), r.Adm x → ∀ A : Prop, (A ↔ r.Value x) → (A ↔ Bit r x)) ∧
    (∀ (r : Row.{0}) (x : r.X), r.Adm x → ∀ O : Prop, (O → r.Value x) → O → ActAt r x ∧ Bit r x) :=
  ⟨existence_half_is_not_the_sentence, existence_half_forces_nothing, forced_blowup_decides_nothing,
   binary_statement_gives_ternary, ternary_does_not_carry_binary,
   fun r x hx A h => adoption_is_the_bit r x hx A h, fun r x hx O h o => reflection_is_a_route r x hx O h o⟩

