/-! ## The binding -/

/-- THE VERDICT READS ITS WEAKEST FACE: theorem faces joined with the premise face read premise. The bit stays at its
    grade; nothing here lifts it. -/
theorem the_verdict_reads_its_weakest_face :
    YM.NORMALFORM.Grade.weakest (YM.NORMALFORM.Grade.weakest .thm .thm) .premise = .premise :=
  YM.NORMALFORM.join_reads_the_weakest.2

/-- FUTURE PROOF WITH EMPIRICAL WITNESS: the gate on six rows and at the hosts, every witness typed, the ledger checked,
    the bridges from the block's bit to each kernel's transfer, and the grade of the verdict, bound by exact type. No
    premise before the colon. -/
theorem future_proof_with_empirical_witness :
    (type_of% @the_gate_on_six_rows) ∧
    (type_of% @the_gate_at_the_hosts) ∧
    (type_of% @no_bypass.{0}) ∧
    (type_of% @every_witness_typed) ∧
    (type_of% @declared_provability_is_the_bit.{0, 0, 0}) ∧
    (type_of% @declared_obstruction_is_the_block.{0, 0, 0}) ∧
    (type_of% @nielsen_on_the_riemann_row) ∧
    (type_of% @the_ledger) ∧
    (type_of% @ym_bit_is_the_transfer) ∧
    (type_of% @gb_bit_is_the_transfer) ∧
    (type_of% @ns_bit_is_the_transfer) ∧
    (type_of% @the_verdict_reads_its_weakest_face) :=
  ⟨the_gate_on_six_rows, the_gate_at_the_hosts, @no_bypass.{0}, every_witness_typed,
   @declared_provability_is_the_bit.{0, 0, 0}, @declared_obstruction_is_the_block.{0, 0, 0},
   nielsen_on_the_riemann_row, the_ledger, ym_bit_is_the_transfer, gb_bit_is_the_transfer, ns_bit_is_the_transfer,
   the_verdict_reads_its_weakest_face⟩

